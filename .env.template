# ============================================================================
# AutoPC configuration. Copy this file to `.env.local` and edit.
#
# `.env.local` is read from the current directory and from the AutoPC folder
# (the repo for a source checkout, the exe's folder for a build). Anything
# already set in the environment wins over this file. Every setting is
# optional; the values below are the defaults.
# ============================================================================

# ---- Safety -----------------------------------------------------------------
# 1 = report every click, key press and scroll instead of performing it.
# `autopc --dry-run ...` does the same for one run.
AUTOPC_DRY_RUN=0

# ---- Models -----------------------------------------------------------------
# The driver: looks at the screen and acts, turn by turn.
AUTOPC_MODEL=claude-sonnet-5-5
# The reasoner behind `solve`, the definition of done, the verifier, reflection
# and skill distillation. Quality matters more than latency off the hot path.
AUTOPC_SOLVER_MODEL=claude-opus-5-5
AUTOPC_SOLVER_EFFORT=high
# Optional per-role overrides (default: AUTOPC_SOLVER_MODEL).
# AUTOPC_PLANNER_MODEL=
# AUTOPC_VERIFIER_MODEL=
# AUTOPC_REFLECT_MODEL=

# Fresh attempts per task before it is marked failed.
AUTOPC_MAX_ATTEMPTS=3

# ---- Screenshots --------------------------------------------------------------
# Leave blank to send the screen at native resolution, which keeps click
# coordinates 1:1 with the screen. Set a width (e.g. 1400) only to force a
# smaller frame.
AUTOPC_IMAGE_WIDTH=

# ---- Mouse accuracy -----------------------------------------------------------
# Interception injects RELATIVE movement; Windows "Enhance pointer precision"
# then distorts it (measured misses of 26-52px vs ~1px with it off). AutoPC
# disables it while running and restores it on exit. Set 0 to keep your normal
# pointer feel (at the cost of click accuracy).
AUTOPC_DISABLE_MOUSE_ACCEL=1

# ---- Memory + skills ----------------------------------------------------------
# Where learned state lives (core memory, skills, task ledgers, vector index).
# Default: a `data` folder in the AutoPC folder.
# AUTOPC_DATA_DIR=

# Embedder for semantic recall: "onnx" (fastembed, local, no torch),
# "keyword" (zero-dependency fallback), or "none" (disable archival recall).
AUTOPC_EMBEDDER=onnx
# The fastembed model when AUTOPC_EMBEDDER=onnx. bge-small is ~130MB and fast.
AUTOPC_EMBED_MODEL=BAAI/bge-small-en-v1.5

# A successful run must take at least this many meaningful steps before it is
# distilled into a reusable skill.
AUTOPC_SKILL_MIN_STEPS=5

# ---- OmniParser learned UI detector (OPTIONAL) --------------------------------
# A YOLOv9 model that finds interactable controls from pixels alone, which
# improves click snapping on small icons. Off by default; it needs a separate
# OmniParser checkout and weights.
AUTOPC_OMNIPARSER=0
# Run the detector in a separate (e.g. CUDA) Python instead of in-process.
AUTOPC_OMNIPARSER_SIDECAR=0
AUTOPC_OMNIPARSER_PYTHON=
AUTOPC_OMNIPARSER_HOME=
AUTOPC_OMNIPARSER_IMGSZ=1280
